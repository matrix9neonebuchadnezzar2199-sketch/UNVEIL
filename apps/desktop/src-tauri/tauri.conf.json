{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UNVEIL",
  "version": "0.1.0",
  "identifier": "com.unveil.research",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:14250",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "UNVEIL",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 768,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self'; font-src 'self'; connect-src ipc: http://ipc.localhost http://localhost:14250 ws://localhost:14250; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
